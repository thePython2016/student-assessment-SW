{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/student-assessment/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://student-assessment-4ipf.onrender.com  /api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}