{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/student-assessment/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://127.0.0.1:8000/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}